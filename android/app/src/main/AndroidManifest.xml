<?xml version="1.0" encoding="utf-8"?>
<!-- 이 파일이 UTF-8 인코딩을 사용하는 XML 문서라는 뜻 -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- manifest: 안드로이드 앱의 전체 설정 파일 시작 -->
    <!-- xmlns:android : android: 로 시작하는 속성을 쓰기 위한 선언 -->
    <!-- xmlns:tools : tools: 로 시작하는 속성을 쓰기 위한 선언 -->
    <!-- 지금 이 코드에서는 tools를 실제로 안 쓰고 있어서 없어도 될 수 있음 -->
    <queries> <!--앱 가시성  선언 시작 (외부 맵 조회를 위해 필요)-->
        <!-- 팬텀 조회 -->
        <package android:name="app.phantom" />

        <!-- 솔플레어 조회 -->
        <package android:name="com.solflare.mobile" />

        <!-- 백팩 조회 -->
        <package android:name="app.backpack.mobile" />

        <!-- 백팩 딥링크 조회 -->
        <intent> <!--특정 기능을 수행할 앱을 찾기 (백팩은) 그냥 설정시 앱을 찾지 못함  -->
            <action android:name="android.intent.action.VIEW" /> <!-- 외부 링크를 여는 동작-->
            <data
                android:scheme="https"
                android:host="backpack.app" />
        </intent>
    </queries>


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spentopia">
        <!-- application : 앱 전체 설정 시작 -->

        <!-- allowBackup="true"
             앱 데이터 백업을 허용할지 여부 -->

        <!-- dataExtractionRules="@xml/data_extraction_rules"
             안드로이드의 데이터 추출/백업 관련 규칙 파일을 지정 -->

        <!-- fullBackupContent="@xml/backup_rules"
             전체 백업 시 어떤 데이터를 백업할지 규칙 파일 지정 -->

        <!-- icon="@mipmap/ic_launcher"
             앱 기본 아이콘 설정 -->

        <!-- label="@string/app_name"
             앱 이름 설정
             실제 문자열은 res/values/strings.xml 의 app_name 값을 사용 -->

        <!-- roundIcon="@mipmap/ic_launcher_round"
             둥근 형태 아이콘이 필요한 런처에서 사용할 아이콘 -->

        <!-- supportsRtl="true"
             아랍어, 히브리어처럼 오른쪽→왼쪽 언어 레이아웃 지원 여부 -->

        <!-- theme="@style/Theme.Spentopia"
             앱 전체에 기본으로 적용할 테마 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Spentopia">
            <!-- activity : 하나의 화면(Activity) 설정 -->

            <!-- name=".MainActivity"
                 실행할 액티비티 클래스 이름
                 .MainActivity 는 현재 패키지 안의 MainActivity를 뜻함 -->

            <!-- exported="true"
                 외부(런처 포함)에서 이 액티비티를 실행할 수 있는지 설정
                 MAIN / LAUNCHER 가 있으면 보통 true 필요 -->

            <!-- label="@string/app_name"
                 이 액티비티의 이름(제목) 설정
                 따로 안 주면 application의 label을 따라가는 경우가 많음 -->

            <!-- theme="@style/Theme.Spentopia"
                 이 액티비티에 적용할 테마
                 앱 전체 테마와 같게 지정해둔 상태 -->

            <intent-filter>
                <!-- intent-filter :
                     이 액티비티가 어떤 방식으로 호출될 수 있는지 정의 -->

                <action android:name="android.intent.action.MAIN" />
                <!-- MAIN :
                     이 액티비티를 앱의 시작 진입점으로 사용하겠다는 의미 -->

                <category android:name="android.intent.category.LAUNCHER" />
                <!-- LAUNCHER :
                     이 액티비티를 휴대폰 런처(앱 아이콘 눌렀을 때)에서 실행되는 화면으로 지정 -->
            </intent-filter>
        </activity>
    </application>

</manifest>